# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit it.

# Root credentials for the MinIO instance (used for admin/console login and
# by `mc` when creating the bucket / setting its public-read policy).
# Pick your own strong values — these are not real credentials.
MINIO_ROOT_USER=your-minio-root-user
MINIO_ROOT_PASSWORD=your-minio-root-password

# Name of the bucket Conchi uploads photos/PDFs into. Created manually per
# the README — not created automatically by this compose file.
# S3 bucket-naming constraints: lowercase letters/digits/hyphens/dots only,
# 3-63 characters, no underscores.
MINIO_BUCKET=your-minio-bucket

# Host ports MinIO's S3 API and web console are exposed on.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
